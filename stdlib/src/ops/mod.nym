interface Plus<Other, Output> {
  func plus(other: Other): Output
}

interface Minus<Other, Output> {
  func minus(other: Other): Output
}

interface Times<Other, Output> {
  func times(other: Other): Output
}

interface Divide<Other, Output> {
  func divide(other: Other): Output
}

interface Remainder<Other, Output> {
  func remainder(other: Other): Output
}

interface Power<Other, Output> {
  func power(other: Other): Output
}

external(power_domain_error) func scalar_power_domain_error(): never

interface Negate<Output> {
  func negate(): Output
}

interface LeftShift<Other, Output> {
  func shl(other: Other): Output
}

interface RightShift<Other, Output> {
  func shr(other: Other): Output
}

interface BitAnd<Other, Output> {
  func bit_and(other: Other): Output
}

interface BitOr<Other, Output> {
  func bit_or(other: Other): Output
}

interface BitXor<Other, Output> {
  func bit_xor(other: Other): Output
}

interface BitNot<Output> {
  func bit_not(): Output
}

interface Not<Output> {
  func not(): Output
}

enum Order {
  LessThan,
  Equal,
  GreaterThan,
}

func compare_ints(first: int, second: int): int =
  if (first < second) -1 else if (first > second) 1 else 0
func compare_uints(first: uint, second: uint): int =
  if (first < second) -1 else if (first > second) 1 else 0
func compare_floats(first: float, second: float): int =
  if (first < second) -1 else if (first > second) 1 else 0
func compare_int_uint(first: int, second: uint): int =
  if (first < second) -1 else if (first > second) 1 else 0
func compare_uint_int(first: uint, second: int): int =
  if (first < second) -1 else if (first > second) 1 else 0
external(compare_char) func compare_chars(first: char, second: char): int
external(compare_string) func compare_strings(first: string, second: string): int

func order_from_sign(sign: int): Order = if (sign < 0) {
  Order.LessThan
} else if (sign > 0) {
  Order.GreaterThan
} else {
  Order.Equal
}

interface Equals<Other> {
  func equals(other: Other): boolean

  func not_equals(other: Other): boolean = !this.equals(other)
}

interface Hash: Equals<Other = self> {
  /// Equal values must return equal hashes. State used by `hash`/`equals` must
  /// not change while the value is stored as a map or set key.
  func hash(): int
}

interface Display {
  func display(): string
}

interface Debug {
  func debug(): string
}

interface Contains<Item: Equals<Other = Item>> {
  func contains(item: Item): boolean

  func not_contains(item: Item): boolean = !this.contains(item)
}

interface Unwrap<Output> {
  func unwrap(default: Output): Output
}

interface Index<Key, Output> {
  func index(key: Key): Output
}

impl<T> Index<Key = uint, Output = T> for #[T] {
  external func index(key: uint): T
}

interface Into<Other> {
  func into(): Other
}

interface Comparable<Other> {
  func compare_to(other: Other): Order

  func less_than(other: Other): boolean = this.compare_to(other) == Order.LessThan
  func less_than_eq(other: Other): boolean = this.compare_to(other) != Order.GreaterThan

  func greater_than(other: Other): boolean = this.compare_to(other) == Order.GreaterThan
  func greater_than_eq(other: Other): boolean = this.compare_to(other) != Order.LessThan

  // `min`/`max` are deliberately not provided here: a default body can only be
  // checked once, generically, for every future implementor (Slice 4C-b), and
  // `Other` is not provably `self` at that level of genericity (only every
  // *concrete* impl in this file happens to choose `Other = self`) — returning
  // either `this` or `other` from one body would require that equality to be
  // real, not just conventional. Provide `min`/`max` per concrete type instead.

  impl Equals<Other> {
    func equals(other: Other): boolean = this.compare_to(other) == Order.Equal
  }
}

// --- Primitive / generic implementations that have no type-specific module ---

// Plus for int
impl Plus<Other = self, Output = self> for int {
  external func plus(other: self): self
}

impl Plus<Other = float, Output = float> for int {
  external func plus(other: float): float
}

// Plus for float
impl Plus<Other = self, Output = self> for float {
  external func plus(other: self): self
}

impl Plus<Other = int, Output = self> for float {
  external func plus(other: int): self
}

// Plus for char
impl Plus<Other = int, Output = self> for char {
  external(plus_char_int) func plus(other: int): self
}

// Minus for int
impl Minus<Other = int, Output = int> for int {
  external(minus) func minus(other: int): int
}

impl Minus<Other = float, Output = float> for int {
  external(minus) func minus(other: float): float
}

// Minus for float
impl Minus<Other = float, Output = float> for float {
  external(minus) func minus(other: float): float
}

impl Minus<Other = int, Output = float> for float {
  external(minus) func minus(other: int): float
}

// Times for int
impl Times<Other = self, Output = self> for int {
  external func times(other: self): self
}

impl Times<Other = float, Output = float> for int {
  external func times(other: float): float
}

// Times for float
impl Times<Other = self, Output = self> for float {
  external func times(other: self): self
}

impl Times<Other = int, Output = self> for float {
  external func times(other: int): self
}

// Divide for int
impl Divide<Other = int, Output = float> for int {
  external(divide) func divide(other: int): float
}

impl Divide<Other = float, Output = float> for int {
  external(divide) func divide(other: float): float
}

// Divide for float
impl Divide<Other = float, Output = float> for float {
  external(divide) func divide(other: float): float
}

impl Divide<Other = int, Output = float> for float {
  external(divide) func divide(other: int): float
}

// Remainder for int
impl Remainder<Other = int, Output = int> for int {
  external func remainder(other: int): int
}

// --- Mixed int <-> uint operators (both directions) ---
// Arithmetic yields the wider signed domain `int` (a mixed result can be
// negative, e.g. `(2 as int) - (5 as uint)`); division yields `float`;
// comparison/equality yield `boolean`. Same-type `uint` operators are handled
// by the native fast path, so only the cross-type pairs are declared here.
// Like the other primitive operator impls these lower to native JS operators
// (the `external` bodies are never emitted). An `int`-literal argument still
// resolves to the same-type impl via the resolver's exact-over-widened
// preference, so `a.plus(2)` stays unambiguous.
impl Plus<Other = uint, Output = int> for int {
  external func plus(other: uint): int
}
impl Plus<Other = int, Output = int> for uint {
  external func plus(other: int): int
}

impl Minus<Other = uint, Output = int> for int {
  external(minus) func minus(other: uint): int
}
impl Minus<Other = int, Output = int> for uint {
  external(minus) func minus(other: int): int
}

impl Times<Other = uint, Output = int> for int {
  external func times(other: uint): int
}
impl Times<Other = int, Output = int> for uint {
  external func times(other: int): int
}

impl Divide<Other = uint, Output = float> for int {
  external(divide) func divide(other: uint): float
}
impl Divide<Other = int, Output = float> for uint {
  external(divide) func divide(other: int): float
}

impl Remainder<Other = uint, Output = int> for int {
  external func remainder(other: uint): int
}
impl Remainder<Other = int, Output = int> for uint {
  external func remainder(other: int): int
}

impl Comparable<Other = uint> for int {
  func compare_to(other: uint): Order = order_from_sign(compare_int_uint(this, other))
}
impl Comparable<Other = int> for uint {
  func compare_to(other: int): Order = order_from_sign(compare_uint_int(this, other))
}

impl Equals<Other = uint> for int {
  external(primitive_equals) func equals(other: uint): boolean
}
impl Equals<Other = int> for uint {
  external(primitive_equals) func equals(other: int): boolean
}

// Integer-exponent powers are ordinary Nymph so every call observes the
// language's zero-domain rules instead of falling through to JavaScript `**`.
// The three helpers intentionally use exponentiation by squaring.
func int_power_uint(base: int, exponent: uint): int = {
  let mut result = 1
  let mut factor = base
  let mut remaining = exponent
  while (remaining > 0) {
    if (remaining % 2 == 1) { result = result * factor }
    remaining = (remaining / 2u) as uint
    if (remaining > 0) { factor = factor * factor }
  }
  result
}

func uint_power_uint(base: uint, exponent: uint): uint = {
  let mut result: uint = 1
  let mut factor = base
  let mut remaining = exponent
  while (remaining > 0) {
    if (remaining % 2 == 1) { result = result * factor }
    remaining = (remaining / 2u) as uint
    if (remaining > 0) { factor = factor * factor }
  }
  result
}

func float_power_uint(base: float, exponent: uint): float = {
  let mut result = 1.0
  let mut factor = base
  let mut remaining = exponent
  while (remaining > 0) {
    if (remaining % 2 == 1) { result = result * factor }
    remaining = (remaining / 2u) as uint
    if (remaining > 0) { factor = factor * factor }
  }
  result
}

impl Power<Other = uint, Output = int> for int {
  func power(other: uint): int = int_power_uint(this, other)
}

impl Power<Other = uint, Output = uint> for uint {
  func power(other: uint): uint = uint_power_uint(this, other)
}

impl Power<Other = uint, Output = float> for float {
  func power(other: uint): float = float_power_uint(this, other)
}

impl Power<Other = int, Output = float> for int {
  func power(other: int): float = if (other < 0) {
    if (this == 0) { scalar_power_domain_error() }
    1.0 / float_power_uint(this as float, other as uint)
  } else {
    float_power_uint(this as float, other as uint)
  }
}

impl Power<Other = int, Output = float> for uint {
  func power(other: int): float = if (other < 0) {
    if (this == 0) { scalar_power_domain_error() }
    1.0 / float_power_uint(this as float, other as uint)
  } else {
    float_power_uint(this as float, other as uint)
  }
}

impl Power<Other = int, Output = float> for float {
  func power(other: int): float = if (other < 0) {
    if (this == 0.0) { scalar_power_domain_error() }
    1.0 / float_power_uint(this, other as uint)
  } else {
    float_power_uint(this, other as uint)
  }
}

// Negate for int/float
impl Negate<Output = int> for int {
  func negate(): int = this * -1
}

impl Negate<Output = float> for float {
  func negate(): float = this * -1
}

// Bitwise for int
impl LeftShift<Other = int, Output = int> for int {
  external(shl) func shl(other: int): int
}

impl RightShift<Other = int, Output = int> for int {
  external(shr) func shr(other: int): int
}

impl BitAnd<Other = int, Output = int> for int {
  external(bit_and) func bit_and(other: int): int
}

impl BitOr<Other = int, Output = int> for int {
  external(bit_or) func bit_or(other: int): int
}

impl BitXor<Other = int, Output = int> for int {
  external(bit_xor) func bit_xor(other: int): int
}

impl BitNot<Output = int> for int {
  external(bit_not) func bit_not(): int
}

// Bitwise for boolean
impl BitAnd<Other = boolean, Output = boolean> for boolean {
  func bit_and(other: boolean): boolean = if (this) other else false
}

impl BitOr<Other = boolean, Output = boolean> for boolean {
  func bit_or(other: boolean): boolean = if (this) true else other
}

impl BitXor<Other = boolean, Output = boolean> for boolean {
  func bit_xor(other: boolean): boolean = if (this) !other else other
}

impl BitNot<Output = boolean> for boolean {
  func bit_not(): boolean = !this
}

// Boolean ops
impl Not<Output = boolean> for boolean {
  func not(): boolean = if (this) false else true
}

// Comparable for int
impl Comparable<Other = self> for int {
  func compare_to(other: self): Order = order_from_sign(compare_ints(this, other))
}

// Comparable for float
impl Comparable<Other = self> for float {
  func compare_to(other: self): Order = order_from_sign(compare_floats(this, other))
}

// Comparable for char
impl Comparable<Other = self> for char {
  func compare_to(other: self): Order = order_from_sign(compare_chars(this, other))
}

// Comparable for string
impl Comparable<Other = self> for string {
  func compare_to(other: self): Order = order_from_sign(compare_strings(this, other))
}

// Comparable for boolean
impl Comparable<Other = self> for boolean {
  func compare_to(other: self) = match (#(this, other)) {
    #(false, true) -> Order.LessThan,
    #(false, false) | #(true, true) -> Order.Equal,
    #(true, false) -> Order.GreaterThan,
  }
}

// Comparable for unit
impl Comparable<Other = self> for #() {
  func compare_to(_: self) = Order.Equal
}

// Comparable extension: minmax
impl<T> Comparable<Other = T> for T {
  func minmax(other: T) =
    if (this.compare_to(other) == Order.LessThan) #(this, other) else #(other, this)  
}

// Equals blanket impl
impl<T> Equals<Other = self> for T {
  external(equals) func equals(other: self): boolean
  external(not_equals) func not_equals(other: self): boolean
}

impl<T: Equals<Other = T>> Hash for T {
  external(hash) func hash(): int
}

impl<T> Display for T {
  external(display) func display(): string
}

impl<T> Debug for T {
  external(debug) func debug(): string
}

impl<T: Display> Into<string> for T {
  external(display) func into(): string
}
