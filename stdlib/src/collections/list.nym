import @/option with (Option)
import @/ops with (Plus, Comparable, Contains, Equals, Index, Order)

impl<T> #[T] {
  external(length) func length(): uint
  external(get) func get(i: uint): Option<T>

  func is_empty(): boolean = this.length() == 0u
  func is_not_empty(): boolean = !this.is_empty()

  /// Returns a new list with `item` appended. The source list is unchanged.
  external(appended) func appended(item: T): #[T]

  /// Returns a new list with the element at `i` replaced. The source list is unchanged.
  external(replaced) func replaced(i: uint, item: T): #[T]

  /// Returns the first element, or `None` if empty.
  func first(): Option<T> = this.get(0)

  /// Returns the last element, or `None` if empty.
  func last(): Option<T> =
    if (this.is_empty()) Option.None else this.get(this.length() - 1)

  /// Returns a new list with elements from `start` (inclusive) to `end` (exclusive).
  external(slice) func slice(start: uint, end: uint): #[T]

  /// Returns a new list with `other` appended.
  func concat(other: #[T]): #[T] = loop@concat_items (
    let result = this,
    let index = 0u,
  ) {
    match (other.get(index)) {
      Some(item) -> continue(result = result.appended(item), index = index + 1u),
      None -> break@concat_items result,
    }
  }

  /// Returns a new list with the elements in reverse order.
  func reversed(): #[T] = loop@reverse_items (
    let result: #[T] = #[],
    let end = this.length(),
  ) {
    if (end == 0u) { break@reverse_items result }
    continue(result = result.appended(this[(end - 1u) as int]), end = end - 1u)
  }

  /// Returns a list of sub-lists, each of the given `size` (the last chunk may be smaller).
  func chunked(size: uint): #[#[T]] = {
    if (size == 0u) { break@chunked #[] }
    loop@build_chunks (
      let start = 0u,
      let result: #[#[T]] = #[],
    ) {
      if (start >= this.length()) { break@build_chunks result }
      continue(
        start = start + size,
        result = result.appended(this.slice(start, start + size)),
      )
    }
  }

  /// Returns a new list with the first `n` elements dropped.
  func drop(n: uint): #[T] = this.slice(n, this.length())

  /// Returns a new list with only the first `n` elements.
  func take(n: uint): #[T] = this.slice(0, n)

  /// Returns whether any element satisfies `predicate`, stopping at the first match.
  func any(predicate: (T) -> boolean): boolean = loop@find_match (let index = 0u) {
    if (index >= this.length()) { break@find_match false }
    if (predicate(this[index as int])) { break@find_match true }
    continue(index = index + 1u)
  }

  /// Returns a new list stably ordered by `compare`; the source is unchanged.
  func sort_by(compare: (T, T) -> Order): #[T] = loop@sort_items (
    let result = this,
    let index = 1u,
  ) {
    if (index >= this.length()) { break@sort_items result }
    let inserted = loop@insert_item (
      let current = result,
      let insert_index = index,
    ) {
      if (insert_index == 0u) { break@insert_item current }
      match (compare(current[insert_index as int], current[(insert_index - 1u) as int])) {
        LessThan -> {
          let previous = current[(insert_index - 1u) as int]
          continue(
            current = current
              .replaced(insert_index - 1u, current[insert_index as int])
              .replaced(insert_index, previous),
            insert_index = insert_index - 1u,
          )
        },
        _ -> break@insert_item current,
      }
    }
    continue(result = inserted, index = index + 1u)
  }
}

impl<T> Index<Key = int, Output = T> for #[T] {
  external func index(key: int): T
}

impl<T> #[T] {
  /// Converts each element to a string and joins them with `separator`.
  func join(separator: string): string = loop@join_items (
    let index = 0u,
    let result = "",
  ) {
    if (index >= this.length()) { break@join_items result }
    continue(
      index = index + 1u,
      result = result + if (index == 0u) "${this[index as int]}" else separator + "${this[index as int]}",
    )
  }
}

impl<T: Comparable<Other = T>> #[T] {
  /// Returns a new stably sorted list using `Comparable`; the source is unchanged.
  func sort(): #[T] = {
    this.sort_by((left, right) -> left.compare_to(right))
  }
}

impl<T: Equals<Other = T>> #[T] {
  /// Returns a new list with duplicate elements removed, preserving first-seen order.
  func distinct(): #[T] = loop@distinct_items (
    let index = 0u,
    let result: #[T] = #[],
  ) {
    if (index >= this.length()) { break@distinct_items result }
    continue(
      index = index + 1u,
      result = if (result.contains(this[index as int])) result else result.appended(this[index as int]),
    )
  }
}

impl<T> Plus<Other = self, Output = self> for #[T] {
  func plus(other: self): self = this.concat(other)
}

impl<T: Equals<Other = T>> Contains<Item = T> for #[T] {
  func contains(item: T): boolean = {
    for (candidate in this) {
      if (candidate.equals(item)) {
        break@contains true
      }
    }
    false
  }
}
