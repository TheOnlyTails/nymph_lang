import @/option with (Option)
import @/ops with (Plus, Comparable, Contains, Equals, Into, Order)

impl<T> mut #[T] {
  external(length) func length(): uint
  external(insert) func insert(i: uint, item: T): void
  external(get) func get(i: uint): Option<T>
  external(remove) func remove(i: uint): Option<T>
  external(clear) func clear(): void
  external(splice) func splice(start: uint, end: uint, replacement: #[T]): #[T]

  /// Appends an item to the end of the list.
  external(push) func push(item: T): void

  /// Removes and returns the last element, or `None` if empty.
  func pop(): Option<T> =
    if (this.is_empty()) Option.None else this.remove(this.length() - 1)

  func is_empty(): boolean = this.length() == 0
  func is_not_empty(): boolean = !this.is_empty()
}

impl<T> #[T] {
  external(length) func length(): uint
  external(get) func get(i: uint): Option<T>

  /// Returns the first element, or `None` if empty.
  func first(): Option<T> = this.get(0)

  /// Returns the last element, or `None` if empty.
  func last(): Option<T> =
    if (this.is_empty()) Option.None else this.get(this.length() - 1)

  /// Returns a new list with elements from `start` (inclusive) to `end` (exclusive).
  external(slice) func slice(start: uint, end: uint): #[T]

  /// Returns a new list with `other` appended.
  func concat(other: #[T]): #[T] = {
    let mut result = this.slice(0, this.length())
    for (item in other) {
      result.push(item)
    }
    result
  }

  /// Returns a new list with the elements in reverse order.
  func reversed(): #[T] = {
    let mut result: #[T] = #[]
    let mut i = this.length()
    while (i > 0) {
      i = i - 1
      result.push(this[i])
    }
    result
  }

  /// Returns a list of sub-lists, each of the given `size` (the last chunk may be smaller).
  func chunked(size: uint): #[#[T]] = {
    let mut result: #[#[T]] = #[]
    if (size > 0) {
      let mut start: uint = 0
      while (start < this.length()) {
        result.push(this.slice(start, start + size))
        start = start + size
      }
    }
    result
  }

  /// Returns a new list with the first `n` elements dropped.
  func drop(n: uint): #[T] = this.slice(n, this.length())

  /// Returns a new list with only the first `n` elements.
  func take(n: uint): #[T] = this.slice(0, n)

  /// Returns whether any element satisfies `predicate`, stopping at the first match.
  func any(predicate: (T) -> boolean): boolean = {
    let mut i: uint = 0
    while (i < this.length()) {
      if (predicate(this[i])) {
        return true
      }
      i = i + 1
    }
    false
  }

  /// Returns a new list stably ordered by `compare`; the source is unchanged.
  func sort_by(compare: (T, T) -> Order): #[T] = {
    let mut result = this.slice(0, this.length())
    let mut i = 1
    while (i < result.length()) {
      let mut j = i
      while (j > 0 && compare(result[j], result[j - 1]) == Order.LessThan) {
        let previous = result[j - 1]
        result[j - 1] = result[j]
        result[j] = previous
        j = j - 1
      }
      i = i + 1
    }
    result
  }
}

impl<T: Into<Other = string>> #[T] {
  /// Converts each element to a string and joins them with `separator`.
  func join(separator: string): string = {
    let mut result = ""
    let mut i: uint = 0
    while (i < this.length()) {
      if (i > 0) {
        result = result + separator
      }
      // `Into<string>`'s standard blanket implementation delegates to the same
      // `Display` conversion used by interpolation.
      result = result + "${this[i]}"
      i = i + 1
    }
    result
  }
}

impl<T: Comparable<Other = T>> #[T] {
  /// Returns a new stably sorted list using `Comparable`; the source is unchanged.
  func sort(): #[T] = {
    this.sort_by((left, right) -> left.compare_to(right))
  }
}

impl<T: Equals<Other = T>> #[T] {
  /// Returns a new list with duplicate elements removed, preserving first-seen order.
  func distinct(): #[T] = {
    let mut result: #[T] = #[]
    for (item in this) {
      if (!result.contains(item)) {
        result.push(item)
      }
    }
    result
  }
}

impl<T> Plus<Other = self, Output = self> for #[T] {
  func plus(other: self): self = this.concat(other)
}

impl<T: Equals<Other = T>> Contains<Item = T> for #[T] {
  func contains(item: T): boolean = {
    for (candidate in this) {
      if (candidate.equals(item)) {
        return true
      }
    }
    false
  }
}
