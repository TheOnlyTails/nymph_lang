import @/ops with (Hash)

public struct Set<Item: Hash>(inner: #{Item: #()}) {
  /// Inserts an item into the set.
  /// Returns `true` if the set did not contain this item previously, and `false` if it did.
  mut func insert(item: Item): boolean = this.inner.insert(item, #())

  mut func remove(item: Item) = if (item in this.inner) {
    this.inner.remove(item)
    true
  } else false

  namespace func new(...from: #[Item]): Set<Item> = {
    let mut inner: #{Item: #()} = #{}
    for (item in from) {
      inner.insert(item, #())
    }

    Set(inner = inner)
  }

  impl Contains<Item> {
    func contains(item: Item): boolean = this.inner.contains_key(item)
  }

  impl Default {
    func default() = {
      let inner: #{Item: #()} = #{}
      Set(inner = inner)
    }
  }
}
