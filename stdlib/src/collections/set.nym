external(set_inserted) func persistent_set_inserted<Item>(set: Set<Item>, item: Item): Set<Item>
external(set_removed) func persistent_set_removed<Item>(set: Set<Item>, item: Item): Set<Item>

public struct Set<Item>(inner: #{Item: #()}) {
  /// Returns a set containing `item` without changing this set.
  func inserted(item: Item): Set<Item> = persistent_set_inserted(this, item)

  /// Returns a set without `item`, without changing this set.
  func removed(item: Item): Set<Item> = persistent_set_removed(this, item)

  namespace func new(...from: #[Item]): Set<Item> =
    from.iter().fold(Set(inner = #{}), (set, item) -> set.inserted(item))

  impl Contains<Item> {
    func contains(item: Item): boolean = this.inner.contains_key(item)
  }

  impl Iterable<Item> {
    func iter(): ListIter<Item> = this.inner.keys().iter()
  }

  impl Default {
    func default() = {
      let inner: #{Item: #()} = #{}
      Set(inner = inner)
    }
  }
}
