import @/ops with (Comparable, Contains)

public enum Bound<Idx> {
  Included(value: Idx),
  Excluded(value: Idx),
  Unbounded
}

public interface RangeBounds<Idx: Comparable<Idx>> : Contains<Idx> {
  func start_bound(): Bound<Idx>
  func end_bound(): Bound<Idx>
  func contains(item: Idx): boolean
}

public struct Range<Idx: Comparable<Idx>>(start: Idx, end: Idx) {
  impl RangeBounds<Idx> {
    func start_bound() = Bound.Included(value = this.start)
    func end_bound() = Bound.Excluded(value = this.end)
    func contains(item: Idx) = this.start <= item && this.end > item
  }

  func is_empty() = this.start >= this.end
}

public struct RangeFrom<Idx: Comparable<Idx>>(start: Idx) {
  impl RangeBounds<Idx> {
    func start_bound() = Bound.Included(value = this.start)
    func end_bound() = Bound.Unbounded
    func contains(item: Idx) = this.start <= item
  }
}

public struct RangeTo<Idx: Comparable<Idx>>(end: Idx) {
  impl RangeBounds<Idx> {
    func start_bound() = Bound.Unbounded
    func end_bound() = Bound.Excluded(value = this.end)
    func contains(item: Idx) = this.end > item
  }
}

public struct RangeInclusive<Idx: Comparable<Idx>>(start: Idx, end: Idx) {
  impl RangeBounds<Idx> {
    func start_bound() = Bound.Included(value = this.start)
    func end_bound() = Bound.Included(value = this.end)
    func contains(item: Idx) = this.start <= item && this.end >= item
  }

  func is_empty() = this.start > this.end
}

public struct RangeToInclusive<Idx: Comparable<Idx>>(end: Idx) {
  impl RangeBounds<Idx> {
    func start_bound() = Bound.Unbounded
    func end_bound() = Bound.Included(value = this.end)
    func contains(item: Idx) = this.end >= item
  }
}
