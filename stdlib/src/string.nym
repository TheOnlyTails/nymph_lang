import @/option with (Option)
import @/ops with (Plus, Into, Contains)
import @/collections/list

impl string {
  /// Returns the number of Unicode code points. Astral code points count once;
  /// combining marks count separately.
  external(length) func length(): uint
  /// Returns the code point at zero-based code-point offset `i`, or `None` when
  /// `i` is outside the string.
  external(char_at) func char_at(i: uint): Option<char>
  /// Returns the half-open code-point range `start..end`. Bounds beyond the end
  /// are clamped and a reversed range is empty.
  external(substring) func substring(start: uint, end: uint): string
  /// Returns the first matching code-point offset, or `None` when not found.
  external(index_of) func index_of(needle: string): Option<uint>
  /// Returns the last matching code-point offset, or `None` when not found.
  external(last_index_of) func last_index_of(needle: string): Option<uint>
  func contains(needle: string): boolean = match (this.index_of(needle)) {
    Some(_) -> true,
    None -> false,
  }
  func starts_with(prefix: string): boolean = this.take(prefix.length()) == prefix
  func ends_with(suffix: string): boolean =
    if (suffix.length() > this.length()) false
    else this.substring(this.length() - suffix.length(), this.length()) == suffix
  external(to_upper) func to_upper(): string
  external(to_lower) func to_lower(): string
  external(trim) func trim(): string
  external(trim_start) func trim_start(): string
  external(trim_end) func trim_end(): string
  func split(separator: string): #[string] = {
    let mut parts: #[string] = #[]
    if (separator.is_empty()) {
      for (item in this.chars()) {
        parts.push("${item}")
      }
    } else {
      let mut remaining = this
      let mut searching = true
      while (searching) {
        match (remaining.index_of(separator)) {
          Some(index) -> {
            parts.push(remaining.take(index))
            remaining = remaining.drop(index + separator.length())
          },
          None -> {
            parts.push(remaining)
            searching = false
          },
        }
      }
    }
    parts
  }
  func replace(from: string, to: string): string = {
    let mut result = ""
    if (from.is_empty()) {
      result = to
      for (item in this.chars()) {
        result = result.concat("${item}").concat(to)
      }
    } else {
      let mut remaining = this
      let mut searching = true
      while (searching) {
        match (remaining.index_of(from)) {
          Some(index) -> {
            result = result.concat(remaining.take(index)).concat(to)
            remaining = remaining.drop(index + from.length())
          },
          None -> {
            result = result.concat(remaining)
            searching = false
          },
        }
      }
    }
    result
  }
  func replace_first(from: string, to: string): string = match (this.index_of(from)) {
    Some(index) -> this.take(index).concat(to).concat(this.drop(index + from.length())),
    None -> this,
  }
  func repeat(n: uint): string = {
    let mut result = ""
    let mut i = 0u
    while (i < n) {
      result = result.concat(this)
      i = i + 1u
    }
    result
  }
  func chars(): #[char] = {
    let mut result: #[char] = #[]
    let mut i = 0u
    while (i < this.length()) {
      match (this.char_at(i)) {
        Some(value) -> result.push(value),
        None -> {},
      }
      i = i + 1u
    }
    result
  }
  external(concat) func concat(other: string): string
  func concat_chars(other: #[char]): string = {
    let mut result = this
    for (item in other) {
      result = result.concat("${item}")
    }
    result
  }
  func reversed(): string = {
    let mut result = ""
    let mut i = this.length()
    while (i > 0u) {
      i = i - 1u
      result = result.concat(this.substring(i, i + 1u))
    }
    result
  }
  /// Pads on the left to `length` Unicode code points.
  func pad_start(length: uint, pad: char): string =
    if (length > this.length()) "${pad}".repeat(length - this.length()).concat(this) else this
  /// Pads on the right to `length` Unicode code points.
  func pad_end(length: uint, pad: char): string =
    if (length > this.length()) this.concat("${pad}".repeat(length - this.length())) else this

  func is_empty() = this.length() == 0
  func is_not_empty() = this.is_empty() == false

  func is_blank() = this.trim().is_empty()

  /// Returns the first Unicode code point, or `None` if empty.
  func first(): Option<char> = this.char_at(0u)

  /// Returns the last Unicode code point, or `None` if empty.
  func last(): Option<char> =
    if (this.is_empty()) None else this.char_at(this.length() - 1u)

  /// Drops the first `n` Unicode code points.
  func drop(n: uint): string = this.substring(n, this.length())

  /// Returns only the first `n` Unicode code points.
  func take(n: uint): string = this.substring(0u, n)
}

impl Plus<Other = self, Output = self> for string {
  external(concat) func plus(other: self): self
}

impl Plus<Other = #[char], Output = self> for string {
  func plus(other: #[char]): self = this.concat_chars(other)
}

impl Contains<Item = string> for string {
  func contains(item: string): boolean = match (this.index_of(item)) {
    Some(_) -> true,
    None -> false,
  }
}

impl Contains<Item = char> for string {
  func contains(item: char): boolean = match (this.index_of("${item}")) {
    Some(_) -> true,
    None -> false,
  }
}
