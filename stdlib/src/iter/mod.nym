import @/option with (Option)
import @/collections/list
import @/ops with (Order)

/// The iterator surface: `next` advances the iterator, so it is a `mut func`
/// (producing the next value mutates the iterator's own state).
///
/// The adapter methods (`map`, `filter`, …) are default methods, so every type
/// that implements `next` inherits the whole lazy-iteration surface for free —
/// the combinators are defined ONCE here, never per collection.
public interface Iterator<Item> {
  mut func next(): Option<Item>

  /// Lazily transform each item with `f`. Returns a new iterator; nothing runs
  /// until the result is consumed (by a `for` loop or a terminal like `to_list`).
  func map<R>(f: (Item) -> R): Mapped<Item, R, self> = Mapped(source = this, f = f)

  /// Lazily keep only the items for which `predicate` holds.
  func filter(predicate: (Item) -> boolean): Filtered<Item, self> =
    Filtered(source = this, predicate = predicate)

  /// Lazily yield at most the first `n` items, then stop.
  func take(n: uint): Take<Item, self> = Take(source = this, remaining = n)

  /// Lazily skip the first `n` items, then yield the rest.
  func drop(n: uint): Drop<Item, self> = Drop(source = this, remaining = n)

  /// Lazily return the remaining items in the stable order defined by `compare`.
  /// The source is materialized and sorted only when the result is first consumed.
  func sorted_by(compare: (Item, Item) -> Order): SortedBy<Item, self> =
    SortedBy(source = this, compare = compare, items = #[], index = 0, initialized = false)

  /// Run `f` for its side effect on every remaining item, draining the iterator.
  mut func for_each(f: (Item) -> void): void = {
    for (item in this) {
      f(item)
    }
  }

  /// Reduce the remaining items to a single value, left to right.
  mut func fold<Acc>(initial: Acc, combine: (Acc, Item) -> Acc): Acc = {
    let mut acc = initial
    for (item in this) {
      acc = combine(acc, item)
    }
    acc
  }

  /// Collect the remaining items into a list.
  mut func to_list(): #[Item] = {
    let mut out: #[Item] = #[]
    for (item in this) {
      out.push(item)
    }
    out
  }

  /// Count the remaining items, draining the iterator.
  mut func count(): uint = {
    let mut n: uint = 0
    for (item in this) {
      n = n + 1
    }
    n
  }
}

/// The lazy adapter behind [`Iterator::map`]: yields `f(x)` for each `x` the
/// wrapped `source` yields.
struct Mapped<Item, R, S: Iterator<Item>>(source: S, f: (Item) -> R) {
  impl Iterator<R> {
    mut func next(): Option<R> = this.source.next().map(this.f)
  }
}

/// The lazy adapter behind [`Iterator::filter`]: advances the source until it
/// finds an item satisfying `predicate` (or the source is exhausted).
struct Filtered<Item, S: Iterator<Item>>(source: S, predicate: (Item) -> boolean) {
  impl Iterator<Item> {
    mut func next(): Option<Item> = {
      // `this.predicate(x)` would parse as a method call named `predicate`; bind the
      // closure field to a local so it is called as an ordinary function value.
      let keep = this.predicate
      let mut found: Option<Item> = Option.None
      let mut searching = true
      while (searching) {
        match (this.source.next()) {
          Some(value) -> if (keep(value)) {
            found = Option.Some(value = value)
            searching = false
          } else {},
          None -> {
            searching = false
          },
        }
      }
      found
    }
  }
}

/// The lazy adapter behind [`Iterator::take`]: yields at most `remaining` items.
struct Take<Item, S: Iterator<Item>>(source: S, remaining: uint) {
  impl Iterator<Item> {
    mut func next(): Option<Item> = if (this.remaining > 0) {
      this.remaining = this.remaining - 1
      this.source.next()
    } else {
      Option.None
    }
  }
}

/// The lazy adapter behind [`Iterator::drop`]: discards the first `remaining`
/// items on the first pull, then yields the rest.
struct Drop<Item, S: Iterator<Item>>(source: S, remaining: uint) {
  impl Iterator<Item> {
    mut func next(): Option<Item> = {
      while (this.remaining > 0) {
        this.remaining = this.remaining - 1
        this.source.next()
      }
      this.source.next()
    }
  }
}

/// The lazy adapter behind [`Iterator::sorted_by`]. The first call to `next`
/// drains and stably sorts the remaining source exactly once; later calls walk
/// the materialized buffer.
struct SortedBy<Item, S: Iterator<Item>>(
  source: S,
  compare: (Item, Item) -> Order,
  items: #[Item],
  index: uint,
  initialized: boolean,
) {
  impl Iterator<Item> {
    mut func next(): Option<Item> = {
      if (!this.initialized) {
        let compare = this.compare
        for (item in this.source) {
          this.items.push(item)
        }
        this.items = this.items.sort_by(compare)
        this.initialized = true
      }

      let current = this.items.get(this.index)
      this.index = this.index + 1
      match (current) {
        Some(value) -> Option.Some(value = value),
        None -> Option.None,
      }
    }
  }
}
