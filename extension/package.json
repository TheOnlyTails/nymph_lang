{
	"name": "nymph",
	"displayName": "Nymph",
	"version": "0.0.1",
	"description": "Support for the Nymph programming language",
	"categories": [
		"Programming Languages"
	],
	"homepage": "https://nymphlang.dev/",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/theonlytails/nymph_lang.git",
		"directory": "extension"
	},
	"publisher": "theonlytails",
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"deploy": "vsce publish"
	},
	"dependencies": {
		"vscode-languageclient": "^10.1.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/vscode": "^1.125.0",
		"@vscode/vsce": "^3.9.2",
		"typescript": "^7.0.2"
	},
	"contributes": {
		"languages": [
			{
				"id": "nymph",
				"aliases": [
					"Nymph",
					"nymph"
				],
				"extensions": [
					".nym",
					".nymph"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "nymph",
				"scopeName": "source.nymph",
				"path": "./syntaxes/nymph.tmLanguage.json"
			},
			{
				"scopeName": "markdown.nymph.codeblock",
				"path": "./syntaxes/nymph.codeblock.json",
				"injectTo": [
					"text.html.markdown"
				],
				"embeddedLanguages": {
					"meta.embedded.block.nymph": "nymph"
				}
			}
		]
	},
	"preview": true,
	"engines": {
		"vscode": "^1.100.0"
	}
}
