import std/io with (println)

/// Behavior, described once as an interface. Any type can promise to be `Shape`.
interface Shape {
  func area(): float
  func name(): string
}

/// A sum type: each variant carries only the fields it needs.
enum Figure {
  Circle(radius: float),
  Rectangle(width: float, height: float),
  Triangle(base: float, height: float),
}

impl Shape for Figure {
  /// Exhaustive `match` — the compiler checks every variant is covered, so adding a
  /// new `Figure` here would fail to compile until it's handled.
  func area(): float = match (this) {
    Circle(radius) -> 3.14159 * radius * radius,
    Rectangle(width, height) -> width * height,
    Triangle(base, height) -> 0.5 * base * height,
  }

  func name(): string = match (this) {
    Circle(...) -> "circle",
    Rectangle(...) -> "rectangle",
    Triangle(...) -> "triangle",
  }
}

/// Generic over anything that is a `Shape` — works for `Figure` or any future type.
func describe<T: Shape>(shape: T): string =
  "${shape.name()} with area ${shape.area()}"

/// Fold a list of shapes into their total area.
func total_area(shapes: #[Figure]): float = {
  let mut sum = 0.0
  for (shape in shapes) {
    sum = sum + shape.area()
  }
  sum
}

func main() = {
  let figures = #[
    Circle(radius = 2.0),
    Rectangle(width = 3.0, height = 4.0),
    Triangle(base = 6.0, height = 2.0),
  ]

  for (figure in figures) {
    println(describe(figure))
  }

  println("total area: ${total_area(figures)}")
}
