import std/io with (println)

/// Classify a number the FizzBuzz way. A `match` on the pair of remainders makes
/// each rule its own arm; guards (`if (...)`) aren't even needed here because the
/// tuple pattern already discriminates every case.
func fizzbuzz(n: int): string = match (#(n % 3, n % 5)) {
  #(0, 0) -> "FizzBuzz",
  #(0, _) -> "Fizz",
  #(_, 0) -> "Buzz",
  _ -> "${n}",
}

func main(): void = {
  for (n in 1..=100) {
    println(fizzbuzz(n))
  }
}
