import std/io with (println)
import std/os with (args)

/// One todo item.
struct Task(id: int, title: string, done: boolean)

/// The intent parsed out of the command line.
enum Command {
  Add(title: string),
  Complete(id: int),
  List,
  Help,
}

/// Turn raw arguments into a `Command`, or explain why we couldn't. List patterns
/// (`#["add", ...words]`) match the subcommand and split off the rest.
func parse(argv: #[string]): Result<Command, string> = match (argv) {
  #["add", ...words] -> if (words.length() == 0) {
    Error("`add` needs a title")
  } else {
    Ok(Command.Add(title = words.join(" ")))
  },
  #["done", id] -> match (id.to_int()) {
    Some(n) -> Ok(Command.Complete(id = n)),
    None -> Error("`done` needs a numeric id, got `${id}`"),
  },
  #["list"] -> Ok(Command.List),
  #["help"] -> Ok(Command.Help),
  #[] -> Ok(Command.Help),
  #[other, ...] -> Error("unknown command `${other}` — try `help`"),
}

/// The app's state: a growing list of tasks and the next id to hand out.
struct Store(tasks: mut #[Task], next_id: int)

impl Store {
  namespace func empty(): Store = Store(tasks = #[], next_id = 1)

  mut func add(title: string): int = {
    let id = this.next_id
    this.tasks.push(Task(id = id, title = title, done = false))
    this.next_id = this.next_id + 1
    id
  }

  /// Mark a task done by rebuilding the list with that one task flipped.
  mut func complete(id: int): Result<int, string> =
    if (this.tasks.any((task) -> task.id == id)) {
      this.tasks = this.tasks
        .iter()
        .map((task) ->
          if (task.id == id) {
            Task(id = task.id, title = task.title, done = true)
          } else {
            task
          })
        .to_list()
      Ok(id)
    } else {
      Error("no task with id ${id}")
    }

  func render(): string =
    if (this.tasks.length() == 0) {
      "no tasks yet — add one with `todo add <title>`"
    } else {
      this.tasks
        .iter()
        .map((task) -> {
          let mark = if (task.done) { "[x]" } else { "[ ]" }
          "${mark} #${task.id} ${task.title}"
        })
        .to_list()
        .join("\n")
    }
}

func usage(): string =
  "todo — a tiny task manager

  todo add <title>   add a task
  todo done <id>     mark a task complete
  todo list          show all tasks
  todo help          show this message"

func main() = {
  let mut store = Store.empty()

  // Nested positional patterns handle both levels at once: `Ok(Add(title))` matches
  // the `Result`'s `Ok` and, positionally, its sole payload against the `Command`
  // variant. A single-field constructor accepts an un-named sub-pattern, so `Ok(...)`
  // takes the inner `Command` pattern directly.
  match (parse(args())) {
    Ok(Add(title)) -> {
      let id = store.add(title)
      println("added #${id}: ${title}")
    },
    Ok(Complete(id)) -> match (store.complete(id)) {
      Ok(done) -> println("completed #${done}"),
      Error(msg) -> println("error: ${msg}"),
    },
    Ok(List) -> println(store.render()),
    Ok(Help) -> println(usage()),
    Error(msg) -> {
      println("error: ${msg}")
      println(usage())
    },
  }
}
