{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "npm: compile - extension",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"run",
				"compile"
			],
			"options": {
				"cwd": "${workspaceFolder}/extension",
			},
			"isBackground": false,
			"presentation": {
				"reveal": "silent",
			},
			"problemMatcher": "$tsc"
		},
		{
			"label": "npm: watch - extension",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"run",
				"watch"
			],
			"options": {
				"cwd": "${workspaceFolder}/extension"
			},
			"isBackground": true,
			"presentation": {
				"reveal": "silent"
			},
			"problemMatcher": "$tsc-watch"
		},
		{
			"label": "Build LSP Server (release)",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--release",
				"--package",
				"nymph-lsp"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": false,
			"presentation": {
				"reveal": "silent",
			},
			"problemMatcher": "$rustc"
		},
		{
			"label": "Build LSP Server (debug)",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--package",
				"nymph-lsp"
			],
			"isBackground": false,
			"presentation": {
				"reveal": "silent"
			},
			"problemMatcher": "$rustc"
		},
		{
			"label": "Build extension + LSP server",
			"dependsOn": [
				"Build LSP Server (debug)",
				"npm: watch - extension"
			],
			"dependsOrder": "parallel",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}