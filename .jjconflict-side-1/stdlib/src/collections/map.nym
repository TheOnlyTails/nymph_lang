import @/option with (Option)
import @/ops with (Plus, Contains)
import @/iter with (Iterator)
import @/iter/iterable with (Iterable, ListIter)

impl<K, V> #{K: V} {
  external(size) func size(): uint
  external(get) func get(key: K): Option<V>
  /// Returns a map containing `key` without changing this map.
  external(inserted) func inserted(key: K, value: V): #{K: V}

  /// Returns a map without `key`, without changing this map.
  external(removed) func removed(key: K): #{K: V}

  /// Returns `true` if the map contains the given key.
  func contains_key(key: K): boolean = match (this.get(key)) {
    Some(_) -> true,
    None -> false,
  }

  /// Returns a list of all keys.
  external(keys) func keys(): #[K]

  /// Returns a list of all values.
  external(values) func values(): #[V]

  /// Returns a list of all key-value pairs as tuples.
  external(entries) func entries(): #[#(K, V)]

  func is_empty(): boolean = this.size() == 0
  func is_not_empty(): boolean = !this.is_empty()
}

impl<K, V> Plus<Other = self, Output = self> for #{K: V} {
  func plus(other: self): self = other.entries().iter().fold(
    this,
    (result, entry) -> result.inserted(entry[0], entry[1]),
  )
}

impl<K, V> Contains<Item = K> for #{K: V} {
  func contains(item: K): boolean = this.contains_key(item)
}

impl<K, V> Iterable<#(K, V)> for #{K: V} {
  func iter(): ListIter<#(K, V)> = this.entries().iter()
}
